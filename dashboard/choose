<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>STRAYD AI Content Dashboard</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0d1117; color: #c9d1d9; margin: 0; padding: 20px; }
        .container { max-width: 800px; margin: auto; background: #161b22; padding: 30px; border-radius: 8px; border: 1px solid #30363d; }
        h1 { color: #f0f6fc; font-size: 24px; margin-top: 0; }
        label { display: block; margin-top: 15px; font-weight: bold; color: #8b949e; }
        input, select, button { width: 100%; padding: 10px; margin-top: 5px; background: #0d1117; border: 1px solid #30363d; color: #c9d1d9; border-radius: 6px; box-sizing: border-box; }
        button { background: #238636; color: white; border: none; font-weight: bold; cursor: pointer; margin-top: 20px; transition: background 0.2s; }
        button:hover { background: #2ea043; }
        #status-box { margin-top: 20px; padding: 15px; background: #0d1117; border: 1px solid #30363d; border-radius: 6px; min-height: 80px; font-family: monospace; white-space: pre-wrap; font-size: 13px; color: #58a6ff; }
        .links-section { margin-top: 20px; display: none; }
        a.download-btn { display: inline-block; padding: 8px 14px; background: #1f6feb; color: white; text-decoration: none; border-radius: 6px; margin-right: 10px; margin-top: 10px; font-size: 14px; }
        a.download-btn:hover { background: #388bfd; }
    </style>
</head>
<body>
<div class="container">
    <h1>STRAYD Social Media Content Director</h1>
    <p>Select your character knowledge base and trigger automated generation via GitHub Actions.</p>

    <label for="gh-token">GitHub Personal Access Token (repo scope):</label>
    <input type="password" id="gh-token" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx">

    <label for="gh-owner">GitHub Username or Organization:</label>
    <input type="text" id="gh-owner" placeholder="e.g. your-username">

    <label for="gh-repo">Repository Name:</label>
    <input type="text" id="gh-repo" placeholder="e.g. strayd-social-agent">

    <label for="character-select">Select Knowledge / Character Base:</label>
    <select id="character-select">
        <option value="martinstrayd">Martin Strayd (martinstrayd.md)</option>
        <option value="suzuki">Suzuki (suzuki.md)</option>
    </select>

    <button onclick="triggerWorkflow()">Start Content Generation Agent</button>

    <label>Execution Status & Logs:</label>
    <div id="status-box">Idle. Ready to trigger...</div>

    <div class="links-section" id="links-section">
        <label>Quick Access & Downloads:</label>
        <div id="download-links"></div>
    </div>
</div>

<script>
    async function triggerWorkflow() {
        const token = document.getElementById('gh-token').value.trim();
        const owner = document.getElementById('gh-owner').value.trim();
        const repo = document.getElementById('gh-repo').value.trim();
        const character = document.getElementById('character-select').value;
        const statusBox = document.getElementById('status-box');

        if (!token || !owner || !repo) {
            alert('Please fill out your GitHub Token, Owner, and Repository Name.');
            return;
        }

        statusBox.textContent = "Triggering GitHub Workflow (social-agent-dynamic.yml)...";

        try {
            const response = await fetch(`https://api.github.com/repos/${owner}/${repo}/actions/workflows/social-agent-dynamic.yml/dispatches`, {
                method: 'POST',
                headers: {
                    'Authorization': `Bearer ${token}`,
                    'Accept': 'application/vnd.github+json',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    ref: 'main',
                    inputs: { character: character }
                })
            });

            if (!response.ok) {
                const errText = await response.text();
                throw new Error(`Failed to trigger workflow: ${response.status} - ${errText}`);
            }

            statusBox.textContent = "Workflow triggered successfully! Polishing execution progress...";
            pollWorkflowRun(token, owner, repo);

        } catch (error) {
            statusBox.textContent = `Error: ${error.message}`;
        }
    }

    async function pollWorkflowRun(token, owner, repo) {
        const statusBox = document.getElementById('status-box');
        let runsFound = false;
        let runId = null;

        for (let i = 0; i < 60; i++) {
            await new Promise(r => setTimeout(r, 5000));
            try {
                const res = await fetch(`https://api.github.com/repos/${owner}/${repo}/actions/runs?per_page=1`, {
                    headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' }
                });
                const data = await res.json();
                if (data.workflow_runs && data.workflow_runs.length > 0) {
                    const run = data.workflow_runs[0];
                    runId = run.id;
                    statusBox.textContent = `Status: ${run.status.toUpperCase()} (${run.conclusion || 'in_progress'})...`;

                    if (run.status === 'completed') {
                        if (run.conclusion === 'success') {
                            statusBox.textContent += "\n\nSUCCESS! Content generated and committed to repository.";
                            showDownloadLinks(owner, repo);
                        } else {
                            statusBox.textContent += `\n\nWorkflow completed with conclusion: ${run.conclusion}`;
                        }
                        return;
                    }
                }
            } catch (e) {
                console.log("Polling error:", e);
            }
        }
        statusBox.textContent += "\n\nPolling timed out, check your GitHub Actions tab directly.";
    }

    function showDownloadLinks(owner, repo) {
        const linksSection = document.getElementById('links-section');
        const downloadDiv = document.getElementById('download-links');
        linksSection.style.display = 'block';

        const todayIso = new Date().toISOString().split('T')[0];
        downloadDiv.innerHTML = `
            <a class="download-btn" href="https://github.com/${owner}/${repo}/tree/main/social-posts/weekly" target="_blank">View Weekly Folders</a>
            <a class="download-btn" href="https://github.com/${owner}/${repo}/tree/main/social-posts/daily" target="_blank">View Daily Folders</a>
            <a class="download-btn" href="https://raw.githubusercontent.com/${owner}/${repo}/main/social-posts/README.md" target="_blank">View README</a>
        `;
    }
</script>
</body>
</html>
